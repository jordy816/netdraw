  {
   "type": "text",
   "x": 90,
   "y": 1130,
   "text": "No local server: every lookup and logon leaves through the edge connector.",
   "size": 14,
   "weight": 400,
   "color": "#0F172A",
   "anchor": "start",
   "id": "i62",
   "group": "g5"
  },
  {
